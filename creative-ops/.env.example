# PostgreSQL / Neon connection string (use pooled URL for serverless runtime).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
BLOB_READ_WRITE_TOKEN=""

# Local-only demo sign-in and seed password. Set a private value before seeding.
NEXT_PUBLIC_DEMO_USER_PASSWORD="replace-with-a-local-demo-password"
DEMO_USER_PASSWORD="replace-with-a-local-demo-password"
