# Direct connection for Prisma CLI commands; pooled connection for app runtime.
DATABASE_URL="postgresql://user:password@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@pooled.db.prisma.io:5432/postgres?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
BLOB_READ_WRITE_TOKEN=""

# Local-only demo sign-in and seed password. Set a private value before seeding.
NEXT_PUBLIC_DEMO_USER_PASSWORD="replace-with-a-local-demo-password"
DEMO_USER_PASSWORD="replace-with-a-local-demo-password"
