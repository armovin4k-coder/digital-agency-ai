generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  CREATIVE
  MANAGER
}

enum CreativeType {
  STATIC  @map("статика")
  VIDEO   @map("видео")
  UGC     @map("UGC")
  BANNER  @map("баннер")
  PREVIEW @map("превью")
  OTHER   @map("другое")
}

enum Priority {
  LOW    @map("low")
  NORMAL @map("normal")
  HIGH   @map("high")
  URGENT @map("urgent")
}

enum TaskStatus {
  NEW         @map("NEW")
  IN_PROGRESS @map("IN_PROGRESS")
  REVIEW      @map("REVIEW")
  REVISION    @map("REVISION")
  DONE        @map("DONE")
}

enum AttachmentType {
  REFERENCE
  RESULT
}

enum AiService {
  MIDJOURNEY @map("Midjourney")
  RUNWAY     @map("Runway")
  CHATGPT    @map("ChatGPT")
  KLING      @map("Kling")
  ELEVENLABS @map("ElevenLabs")
  HEYGEN     @map("HeyGen")
  OTHER      @map("Другое")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatar       String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buyerTasks    Task[]       @relation("BuyerTasks")
  assignedTasks Task[]       @relation("AssignedTasks")
  attachments   Attachment[]
  aiUsages      AiUsage[]
  comments      Comment[]
  activityLogs  ActivityLog[]

  @@index([role])
  @@index([isDemo])
}

model Task {
  id            String       @id @default(uuid())
  offer         String
  geo           String
  creativeType  CreativeType
  quantity      Int
  description   String       @db.Text
  references    String[]     @default([])
  priority      Priority     @default(NORMAL)
  deadline      DateTime
  status        TaskStatus   @default(NEW)
  buyerId       String
  assigneeId    String?
  createdAt     DateTime     @default(now())
  takenAt       DateTime?
  submittedAt   DateTime?
  completedAt   DateTime?
  revisionCount Int          @default(0)
  updatedAt     DateTime     @updatedAt

  buyer       User         @relation("BuyerTasks", fields: [buyerId], references: [id], onDelete: Restrict)
  assignee    User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  aiUsages    AiUsage[]
  comments    Comment[]
  activityLogs  ActivityLog[]

  @@index([status])
  @@index([assigneeId])
  @@index([deadline])
  @@index([buyerId])
  @@index([createdAt])
  @@index([completedAt])
  @@index([geo])
  @@index([priority])
  @@index([status, assigneeId])
  @@index([buyerId, createdAt])
}

model Attachment {
  id            String         @id @default(uuid())
  taskId        String
  userId        String
  url           String         @db.Text
  storagePath   String?
  type          AttachmentType
  revisionRound Int            @default(0)
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime       @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, revisionRound])
  @@index([taskId, type, revisionRound])
  @@index([userId, createdAt])
}

model AiUsage {
  id            String    @id @default(uuid())
  taskId        String
  userId        String
  service       AiService
  credits       Decimal   @db.Decimal(12, 4)
  revisionRound Int       @default(0)
  note          String?   @db.Text
  createdAt     DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, revisionRound])
  @@index([service, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

model ActivityLog {
  id         String      @id @default(uuid())
  taskId     String
  userId     String
  action     String
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  meta       Json        @default("{}")
  createdAt  DateTime    @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
